# 服务端口
PORT=8080
NODE_ENV=development

# 数据库（better-sqlite3）
DB_PATH=./data/zmyl.db

# JWT
JWT_SECRET=change-me-in-production-zmyl-2026
JWT_EXPIRES_IN=8h

# CORS（前端 dev 5173 + 生产 80）
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost

# 限速
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
LOGIN_LIMIT_WINDOW_MS=60000
LOGIN_LIMIT_MAX=10

# 日志
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# 上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# 自动种子（生产可关）
AUTO_SEED=1